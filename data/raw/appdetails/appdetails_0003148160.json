apps/3148160/extras/70a48027d4de0ddc7ad6c62b92bba409.poster.avif?t=1787830329\" width=1170 height=658 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3148160/extras/70a48027d4de0ddc7ad6c62b92bba409.webm?t=1787830329\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3148160/extras/70a48027d4de0ddc7ad6c62b92bba409.mp4?t=1787830329\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" style=\"text-align: center\"><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3148160/extras/37de67e0d177acb9328c5a58ba48f9d5.poster.avif?t=1787830329\" width=1170 height=658 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3148160/extras/37de67e0d177acb9328c5a58ba48f9d5.webm?t=1787830329\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3148160/extras/37de67e0d177acb9328c5a58ba48f9d5.mp4?t=1787830329\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3148160/extras/8261eff474e585166b08f2ebc79169f5.poster.avif?t=1787830329\" width=1170 height=658 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3148160/extras/8261eff474e585166b08f2ebc79169f5.webm?t=1787830329\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3148160/extras/8261eff474e585166b08f2ebc79169f5.mp4?t=1787830329\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" style=\"text-align: center\"><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3148160/extras/ae18aaed82f7abf168b29d76890e12aa.avif?t=1787830329\" width=493 height=81 /></span></p><p class=\"bb_paragraph\" >Cute and full of energy, magical pets are here to help you. Whether it’s boosting production or shortening crop growth time, they’ve got it all covered.</p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3148160/extras/6869affc406990e859afcbf727af465a.poster.avif?t=1787830329\" width=1170 height=658 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3148160/extras/6869affc406990e859afcbf727af465a.webm?t=1787830329\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3148160/extras/6869affc406990e859afcbf727af465a.mp4?t=1787830329\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" style=\"text-align: center\"><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3148160/extras/307befe0df4f1555b59acc05036c9db8.avif?t=1787830329\" width=493 height=81 /></span></p><p class=\"bb_paragraph\" >After gathering ingredients and materials through exploration, return to the island to brew wine, craft handicrafts, and manage your tavern using these carefully prepared items, welcoming every customer drawn in by fine drinks and cuisine.</p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3148160/extras/4282cb9ffa96610cd7708ae3fa17c119.poster.avif?t=1787830329\" width=1170 height=658 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3148160/extras/4282cb9ffa96610cd7708ae3fa17c119.webm?t=1787830329\" type=\"video/webm; codecs=vp9\"><source src=\
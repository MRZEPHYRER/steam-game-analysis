sinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3801060/extras/50cdc7467a3c6e491f6c3890420e41c9.poster.avif?t=1760598071\" width=1170 height=658 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3801060/extras/50cdc7467a3c6e491f6c3890420e41c9.webm?t=1760598071\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3801060/extras/50cdc7467a3c6e491f6c3890420e41c9.mp4?t=1760598071\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >Face the nightmare in a final showdown at the end of your journey to purify this land!</p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3801060/extras/0f2c3e3f09f9cca11e679d1ded66dfb6.poster.avif?t=1760598071\" width=1170 height=658 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3801060/extras/0f2c3e3f09f9cca11e679d1ded66dfb6.webm?t=1760598071\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3801060/extras/0f2c3e3f09f9cca11e679d1ded66dfb6.mp4?t=1760598071\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p>",

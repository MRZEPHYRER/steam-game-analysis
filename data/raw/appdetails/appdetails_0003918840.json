3303\" width=720 height=120 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3918840/extras/7c02455dfff89b882724f147f656fef0.webm?t=1764533303\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3918840/extras/7c02455dfff89b882724f147f656fef0.mp4?t=1764533303\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3918840/extras/f559d059c562f393d3f9e601309be26f.poster.avif?t=1764533303\" width=720 height=300 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3918840/extras/f559d059c562f393d3f9e601309be26f.webm?t=1764533303\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3918840/extras/f559d059c562f393d3f9e601309be26f.mp4?t=1764533303\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" style=\"text-align: center\"><i><strong>Spend your gold wisely — every coin counts. Invest for greater future rewards, but don’t forget to arm your clones and forge your gear. Without balance, your conquest will end before it even begins. Prices may change — instead of the lifesteal axe you hoped for, you might find black holes, anvils, or hats of wisdom on sale. But in skilled hands, there’s always a way to turn it into a winning strategy</strong></i></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3918840/extras/db90b18726209cadce816af193fc72cb.poster.avif?t=1764533303\" width=720 height=120 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3918840/extras/db90b18726209cadce816af193fc72cb.webm?t=1764533303\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3918840/extras/db90b18726209cadce816af193fc72cb.mp4?t=1764533303\" type=\"video/mp4\"></video></span></p><h2 class=\"bb_tag\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3918840/extras/87fa5b7d6f87f99f2f793f485e32ae4f.poster.avif?t=1764533303\" width=720 height=300 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3918840/extras/87fa5b7d6f87f99f2f793f485e32ae4f.webm?t=1764533303\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3918840/extras/87fa5b7d6f87f99f2f793f485e32ae4f.mp4?t=1764533303\" type=\"video/mp4\"></video></span></h2><p class=\"bb_paragraph\" style=\"text-align: center\"><strong><i>Mix traits, weapons, and armor — everything changes how your clones behave and look</i></strong></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><i><strong>Will you deploy a stealthy ninja in light armor with a sword?</strong></i></p></li><li><p class=\"bb_paragraph\" ><i><strong>Or a reckless caster who summons a black hole that consumes everything — enemies, allies… and himself?</strong></i></p></li><li><p class=\"bb_paragraph\" ><i><strong>Or perhaps a blacksmith who forges equipment for your clones right on the battlefield?</strong></i></p></li><li><p class=\"bb_paragraph\" ><i><strong>Or a mage who casts a global barrier protecting every ally?</strong></i></p></li></ul><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><i><strong>Or don't equip your clones, and instead choose one who will absorb all the damage meant for your team, unleashing it in a single powerful superstrike</strong></i></p></li></ul><h2 class=\"bb_tag\" ><u>It’s your choice — you are the rightful master of the worlds!</u></h2><h2 class=\"bb_tag\" ></h2><p class=\"bb_paragraph\" ></p>",

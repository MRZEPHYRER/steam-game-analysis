.com/store_item_assets/steam/apps/3339810/extras/822f5813f1dc455106067a8ac2f68367.poster.avif?t=1788878009\" width=1170 height=658 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3339810/extras/822f5813f1dc455106067a8ac2f68367.webm?t=1788878009\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3339810/extras/822f5813f1dc455106067a8ac2f68367.mp4?t=1788878009\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" style=\"text-align: center\"><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3339810/extras/4ebd7352ba60771f81d11843e2de327d.avif?t=1788878009\" width=750 height=802 /></span></p><p class=\"bb_paragraph\" style=\"text-align: center\"></p>",

t=1768203885\" width=640 height=360 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3377860/extras/4eda7b41860951ae95fad87ceeb568cc.webm?t=1768203885\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3377860/extras/4eda7b41860951ae95fad87ceeb568cc.mp4?t=1768203885\" type=\"video/mp4\"></video></span><br><br><br><strong>🍳 Delicious Cooking and Buffs</strong><br>Cook various dishes with harvested crops and fish.<br>Completed dishes provide useful buffs to help characters in their adventure.<br><br><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3377860/extras/e57b78348e74fae60abea46f0f6a1955.poster.avif?t=1768203885\" width=640 height=360 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3377860/extras/e57b78348e74fae60abea46f0f6a1955.webm?t=1768203885\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3377860/extras/e57b78348e74fae60abea46f0f6a1955.mp4?t=1768203885\" type=\"video/mp4\"></video></span><br><br><br><strong>🏡 Decorate Your Own Farm</strong><br>Customize your farm freely with various items and backgrounds to create your unique style.<br><br><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3377860/extras/bb23a4e274e6b40281b147df3ff6f4f8.poster.avif?t=1768203885\" width=640 height=360 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3377860/extras/bb23a4e274e6b40281b147df3ff6f4f8.webm?t=1768203885\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3377860/extras/bb23a4e274e6b40281b147df3ff6f4f8.mp4?t=1768203885\" type=\"video/mp4\"></video></span><br><br
assets/steam/apps/4023500/extras/7a4bbd4a594337dfa68d155765b7e645.mp4?t=1759956218\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p><h2 class=\"bb_tag\" ><strong><u>Many &quot;Buddies&quot; + Custom Modes</u></strong></h2><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4023500/extras/738f619a53bdcd5858589f46a143783e.poster.avif?t=1759956218\" width=1170 height=548 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4023500/extras/738f619a53bdcd5858589f46a143783e.webm?t=1759956218\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4023500/extras/738f619a53bdcd5858589f46a143783e.mp4?t=1759956218\" type=\"video/mp4\"></video></span></p><h2 class=\"bb_tag\" ><strong><u>Exclusive Behind The Scenes + All Custom Animations</u></strong><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4023500/extras/be356eaed5d18cb3b0391a69986a2498.poster.avif?t=1759956218\" width=1170 height=548 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4023500/extras/be356eaed5d18cb3b0391a69986a2498.webm?t=1759956218\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4023500/extras/be356eaed5d18cb3b0391a69986a2498.mp4?t=1759956218\" type=\"video/mp4\"></video></span></h2><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_strike\">Many unintentional fun bugs...</span> What are you waiting for? Buy<strong> Frob: The</strong> <strong>Incident</strong>!</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><strong>This game was built from the ground up with Godot!</strong></p>",

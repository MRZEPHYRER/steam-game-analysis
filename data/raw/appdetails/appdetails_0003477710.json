      "data": {
        "type": "game",
        "name": "Built to Scale Solitaire",
        "steam_appid": 3477710,
        "required_age": 0,
        "is_free": true,
        "controller_support": "full",
        "detailed_description": "<p class=\"bb_paragraph\" style=\"text-align: center\"><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3477710/extras/956b05b94a781183e2a39d13fdbda2af.avif?t=1768785978\" alt=\"Built to Scale Solitaire logo\" width=1280 height=370 /></span></p><p class=\"bb_paragraph\" > </p><p class=\"bb_paragraph\" >Take a load off your mind with <strong>Built to Scale Solitaire</strong>, a uniquely designed card game about building a musical scale, inspired by Zachtronics' solitaire games.</p><p class=\"bb_paragraph\" ></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>ASSEMBLE:</strong> Stack cards in ascending order by suit, but take care around the Widget cards which need to be<i> assembled</i> in a free cell!</p></li><li><p class=\"bb_paragraph\" ><strong>BUILD SCALES:</strong> Each card sent to the foundation is part of a scale. Arrange your cards right and they'll all fall into place automatically.</p></li><li><p class=\"bb_paragraph\" ><strong>TUNES TO SOLVE TO:</strong> Jam out to original music written by GenericArrangements! Warning: they're <i>very</i> catchy...</p></li><li><p class=\"bb_paragraph\" ><strong>HD TEXTURES:</strong> Play with new, 4K-ready card textures, or switch back to classic textures at any time.</p></li><li><p class=\"bb_paragraph\" ><strong>STATS &amp; ACHIEVEMENTS:</strong> Track your best (and worst) games with built-in stats and earn Steam Achievements.</p></li></ul>",
        "about_the_game": "<p class=\"bb_paragraph\" style=\"text-align: center\"><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3477710/extras/956b05b94a781183e2a39d13fdbda2af.avif?t=1768785978\" alt=\"Built to Scale Solitaire logo\" width=1280 height=370 /></span></p><p class=\"bb_paragraph\" > </p><p class=\"bb_paragraph\" >Take a load off your mind with <strong>Built to Scale Solitaire</strong>, a uniquely designed card game about building a musical scale, inspired by Zachtronics' solitaire games.</p><p class=\"bb_paragraph\" ></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>ASSEMBLE:</strong> Stack cards in ascending order by suit, but take care around the Widget cards which need to be<i> assembled</i> in a free cell!</p></li><li><p class=\"bb_paragraph\" ><strong>BUILD SCALES:</strong> Each card sent to the foundation is part of a scale. Arrange your cards right and they'll all fall into place automatically.</p></li><li><p class=\"bb_paragraph\" ><strong>TUNES TO SOLVE TO:</strong> Jam out to original music written by GenericArrangements! Warning: they're <i>very</i> catchy...</p></li><li><p class=\"bb_paragraph\" ><strong>HD TEXTURES:</strong> Play with new, 4K-ready card textures, or switch back to classic textures at any time.</p></li><li><p class=\"bb_paragraph\" ><strong>STATS &amp; ACHIEVEMENTS:</strong> Track your best (and worst) games with built-in stats and earn Steam Achievements.</p></li></ul>",
        "short_description": "Have you had a busy day from work? Is the daily grind stressing you out? Try Built to Scale Solitaire, a uniquely designed card game inspired by Zachtronics' solitaires!",
        "supported_languages": "English, French, Italian, Dutch",

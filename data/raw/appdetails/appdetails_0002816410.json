ster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2816410/extras/06545b4459c5ea15c049ae267073ae0a.poster.avif?t=1774996192\" width=616 height=266 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2816410/extras/06545b4459c5ea15c049ae267073ae0a.webm?t=1774996192\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2816410/extras/06545b4459c5ea15c049ae267073ae0a.mp4?t=1774996192\" type=\"video/mp4\"></video></span></p>",

54d37ce3201be5742809bbd2fde.webm?t=1787712353\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2937770/extras/108ab54d37ce3201be5742809bbd2fde.mp4?t=1787712353\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" >Once you get used to the controls and familiar with leveling Bub up, we recommend challenging your limits and dive even deeper into the dungeon!</p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2937770/extras/4dd132d998b52cd4cdfd36c15a68dad8.poster.avif?t=1787712353\" width=300 height=168 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2937770/extras/4dd132d998b52cd4cdfd36c15a68dad8.webm?t=1787712353\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2937770/extras/4dd132d998b52cd4cdfd36c15a68dad8.mp4?t=1787712353\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2937770/extras/099a32de16ba76a97baa90ae6a37c7f1.poster.avif?t=1787712353\" width=300 height=168 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2937770/extras/099a32de16ba76a97baa90ae6a37c7f1.webm?t=1787712353\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2937770/extras/099a32de16ba76a97baa90ae6a37c7f1.mp4?t=1787712353\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" >- Uncover the map as you traverse massive castles. Another series first!</p><p class=\"bb_paragraph\" >Castles are massive stages filled with a labyrinth of rooms. Will you get lost in the maze, or will you use your wits to make it through?</p><p class=\"bb_paragraph\" >Unique bosses also await you inside, so give Bub the proper training and equipment to aim for the deepest part.</p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline crossorigin=\"anonymous\" poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2937770/extras/fa93bf63f2b709d6756da868d6195370.poster.avif?t=1787712353\" width=300 height=168 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2937770/extras/fa93bf63f2b709d6756da868d6195370.webm?t=1787712353\" type=\"video/webm; codecs=vp9\"></video></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >- Master new and returning skills!</p><p class=\"bb_paragraph\" >The Water Bubble is back in a new form!</p><p class=\"bb_paragraph\" >You'll also find new skills that will help you along your journey, like Balloon Wig, which you can control mid-air, and Rolling Attack, which wipes enemies out.</p><p class=\"bb_paragraph\" >Use skills to break through paths that were once inaccessible, and wipe out tough enemies all at once!</p><p class=\"bb_paragraph\" >Master them and sweep away your enemies in one fell swoop!</p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2937770/extras/72d8035226415d66c4918d855f8726b6.poster.avif?t=1787712353\" width=300 height=168 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2937770/extras/72d8035226415d66c4918d855f8726b6.webm?t=1787712353\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2937770/extras/72d8035226415d66c4918d855f8726b6.mp4?t=1787712353\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >- Find the skills and strategies that suit you!</p><p class=\"bb_paragraph\" >The skills you have learned become items you can use.</p><p class=\"bb_paragraph\" >The number of items you can take to a dungeon at once is fixed, so it's up to you to decide what kind of skill items and useful items you take and how many of them you take.</p><p class=\"bb_paragraph\" >It is also up to you to decide in what order to strengthen Bub with the treasures you have collected.</p><p class=\"bb_paragraph\" >Try to find the skills and strategies that suit you!</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >■The setting of the story</p><p class=\"bb_paragraph\" >The setting of the new Bubble Bobble game is a world full of &quot;&quot;strange&quot;&quot; sweet treats!</p><p class=\"bb_paragraph\" >Candy-shaped enemies start appearing in vibrant dungeons.&quot;</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >■The Story</p><p class=\"bb_paragraph\" >Bub wakes up to find himself in a strange laboratory.</p><p class=\"bb_paragraph\" >There, the mysterious Dolcen suddenly appears and gives him a</p><p class=\"bb_paragraph\" >mission to gather untouched treasure that lies inside dungeons and castles.</p><p class=\"bb_paragraph\" >Bub loves a good adventure, so how could he resist this talk of treasure?</p><p class=\"bb_paragraph\" >With that, Bub's sweet and silly journey begins.</p>",
